# Database (Supabase or local Postgres)
DATABASE_URL="postgresql://user:password@host:5432/newsletter4link?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@host:5432/newsletter4link" # For migrations

# AI Services
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."

# Web search for Trend Radar (optional - search features disabled if unset)
TAVILY_API_KEY="tvly-..."

# Email Service
EMAIL_PROVIDER="resend"  # "resend" (default) or "graph" (Microsoft Graph API)

# Resend (default provider)
RESEND_API_KEY="re_..."
RESEND_WEBHOOK_SECRET="whsec_..."  # For tracking opens/clicks (from Resend dashboard)

# Email sender identity
FROM_EMAIL="newsletter@linkconsulting.com"
FROM_NAME="Link Consulting AI Newsletter"

# Microsoft Graph (optional - required if EMAIL_PROVIDER=graph)
# AZURE_TENANT_ID="your-azure-tenant-id"
# AZURE_CLIENT_ID="your-azure-app-client-id"
# AZURE_CLIENT_SECRET="your-azure-client-secret"
# GRAPH_SENDER_EMAIL="newsletter@linkconsulting.com"  # O365 mailbox to send from

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Optional: Local development mock toggles
MOCK_SEARCH="false"
MOCK_GENERATION="false"

# Secrets (required in production)
# Signs unsubscribe links in newsletter emails (falls back to CRON_SECRET if unset)
UNSUBSCRIBE_SECRET="your-random-secret-for-unsubscribe-links"
# Required: cron routes (/api/cron/*) reject all requests unless this matches the
# Authorization: Bearer <secret> header Vercel Cron sends.
CRON_SECRET="your-secret-key-for-cron-endpoints"

# Microsoft Graph / SharePoint publishing (optional)
# SHAREPOINT_TENANT_ID=""
# SHAREPOINT_CLIENT_ID=""
# SHAREPOINT_SITE_URL=""
# SHAREPOINT_CERTIFICATE_THUMBPRINT=""
# SHAREPOINT_CERTIFICATE_PRIVATE_KEY=""

# Supabase Auth & Storage
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key" # Required for server-side storage operations
