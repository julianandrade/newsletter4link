# Copy to terraform.tfvars (or *.auto.tfvars) and fill in.
# Do NOT commit the real file - cron_secret is sensitive.

project_id  = "newsletter-link-ai-radar"
region      = "europe-southwest1" # Madrid (closest to Lisbon)
app_name    = "newsletter4link"
db_tier     = "db-g1-small" # budget option: "db-f1-micro" (discouraged for pgvector)
github_repo = "julianandrade/newsletter4link"

# Leave empty on first apply; after `terraform output cloud_run_url`, set this to
# the run.app URL (or a mapped custom domain) and re-apply so NEXT_PUBLIC_APP_URL
# and the Cloud Scheduler target URLs are correct.
app_url = ""

# MUST equal the value you store in the `cron-secret` Secret Manager secret.
# Prefer supplying via env: export TF_VAR_cron_secret="..."
# cron_secret = "replace-with-a-long-random-string"
