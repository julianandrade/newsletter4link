// Link AI Newsletter Engine - Database Schema
// Multi-tenant Newsletter as a Service (NaaS) Platform

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector")]
}

// ==================== MULTI-TENANCY ====================

model Organization {
  id       String   @id @default(cuid())
  name     String
  slug     String   @unique
  plan     Plan     @default(FREE)
  industry Industry @default(TECHNOLOGY)
  logoUrl  String?

  // Billing/limits
  subscriberLimit    Int @default(1000)
  currentSubscribers Int @default(0)

  // Custom domain (Enterprise)
  customDomain String? @unique

  /**
   * When this organization was wound down. Null means live.
   *
   * A nullable timestamp rather than a status enum, so archive and restore are the same
   * write in opposite directions and there is no second field that can disagree with it.
   *
   * Archiving is not only a visibility flag: an archived organization is skipped by the
   * scheduled jobs, and because `getUserOrganizations` filters on this column it can never
   * become `currentOrg`, so every organization-scoped route already refuses it through the
   * `requireOrgContext` it calls today. That is why there is no per-route send guard.
   *
   * It is also the only reversible step before a delete. `Organization` cascades into 19
   * relations including editions already delivered to real inboxes, and this schema has no
   * audit table, so a hard delete leaves no record that it happened.
   */
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations - all tenant-scoped data
  members          OrgUser[]
  invites          OrgInvite[]
  settings         OrgSettings?
  apiKeys          ApiKey[]
  articles         Article[]
  projects         Project[]
  editions         Edition[]
  subscribers      Subscriber[]
  rssSources       RSSSource[]
  curationJobs     CurationJob[]
  templates        EmailTemplate[]
  brandVoices      BrandVoice[]
  mediaAssets      MediaAsset[]
  searchTopics     SearchTopic[]
  searchHistory    SearchHistory[]
  backgroundJobs   BackgroundJob[]
  generationDrafts GenerationDraft[]
  asides           Aside[]
  radarWatches     RadarWatch[]

  @@index([slug])
  @@index([plan])
  @@index([archivedAt])
}

enum Plan {
  FREE // 1,000 subscribers, RSS curation, basic templates
  STARTER // 5,000 subscribers, + Ghost Writer
  PROFESSIONAL // 25,000 subscribers, + Trend Radar, personalization, API
  ENTERPRISE // Unlimited, + custom domain, white-label
}

enum Industry {
  TECHNOLOGY
  FINANCE
  INSURANCE
  HEALTHCARE
  RETAIL
  UTILITIES
  MANUFACTURING
  PROFESSIONAL_SERVICES
  OTHER
}

// Links Supabase auth users to organizations
model OrgUser {
  id             String  @id @default(cuid())
  supabaseUserId String // Supabase auth.users.id
  email          String
  name           String?
  role           OrgRole @default(VIEWER)
  theme          String?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([supabaseUserId, organizationId], name: "supabaseUserId_organizationId")
  @@index([supabaseUserId])
  @@index([organizationId])
  @@index([email])
}

enum OrgRole {
  OWNER // Full access, can delete org
  ADMIN // Manage members, settings
  EDITOR // Manage content, send newsletters
  VIEWER // Read-only access
}

model OrgInvite {
  id        String   @id @default(cuid())
  email     String
  role      OrgRole  @default(EDITOR)
  token     String   @unique @default(cuid())
  expiresAt DateTime

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  createdAt DateTime @default(now())

  @@unique([email, organizationId])
  @@index([token])
  @@index([organizationId])
}

// API Keys for programmatic access (PROFESSIONAL+ plans)
model ApiKey {
  id         String    @id @default(cuid())
  name       String // User-friendly name for the key
  keyHash    String    @unique // SHA-256 hash of the actual key
  keyPrefix  String // First 8 chars for identification (e.g., "nl4l_abc1")
  lastUsedAt DateTime?
  expiresAt  DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([keyHash])
}

// Per-organization settings (replaces global Settings for org-specific config)
model OrgSettings {
  id String @id @default(cuid())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @unique

  // Curation settings
  relevanceThreshold        Float @default(6.0)
  maxArticlesPerEdition     Int   @default(10)
  vectorSimilarityThreshold Float @default(0.85)
  articleMaxAgeDays         Int   @default(7)

  // AI settings
  aiModel        String @default("claude-sonnet-5")
  embeddingModel String @default("text-embedding-ada-002")

  // Branding
  brandVoicePrompt String? @db.Text
  logoUrl          String?
  bannerUrl        String?
  primaryColor     String? @default("#1e3a5f")
  theme            String? @default("linkroad-dark")

  // Email settings
  fromName     String?
  replyToEmail String?

  /**
   * RQ-006: the organization's own description, used to ground the relevance section
   * of a rewrite. Editable in settings and never hardcoded: the plan asked for no Link
   * specifics in code, and its own example heading broke that rule.
   */
  orgContextPrompt String? @db.Text
  rewriteLanguage  String  @default("pt-PT")
  /**
   * The heading of the relevance section, in the organization's own words.
   */
  relevanceHeading String  @default("Relevancia para a Link")

  updatedAt DateTime @updatedAt
}

// Brand voice profiles for Ghost Writer
model BrandVoice {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text
  isDefault   Boolean @default(false)

  // Voice configuration
  personality     String?  @db.Text // Personality description
  toneAttributes  String[] // confident, curious, helpful, etc.
  styleGuidelines String?  @db.Text
  dos             String[] // Things to do
  donts           String[] // Things to avoid
  greetings       String[] // Signature opening phrases
  closings        String[] // Signature closing phrases
  useEmoji        Boolean  @default(false)
  examplePhrases  Json? // { good: string[], bad: string[] }

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([isDefault])
}

// ==================== ARTICLE MODELS ====================

model Article {
  id        String  @id @default(cuid())
  sourceUrl String
  title     String
  content   String  @db.Text
  author    String?

  /**
   * When the publisher published it. Null when nobody told us.
   * Nullable since 6 August 2026, finding C1. `curateArticle` wrote
   * `publishedAt: new Date()`, so every article arriving through a newsletter carried its
   * own ingestion time as its publication date, and the queue showed that under a column
   * headed PUBLISHED. A digest gives a title, a URL and a sentence, and no date at all,
   * so the honest value is absent rather than now: 38 rows were backfilled to null by
   * `scripts/backfill-captured-at.ts`.
   * Anything that sorts or filters on this has to decide what an unknown date means,
   * which is the point. `capturedAt` is what to fall back to.
   */
  publishedAt DateTime?

  /**
   * When we took it in. Always known, because it is our own clock.
   * This is what `publishedAt` was really holding for email-sourced articles. Separating
   * them is what lets a screen say "captured today, published we do not know" instead of
   * stating something untrue.
   */
  capturedAt DateTime @default(now())

  // AI-generated content
  embedding      Float[] // pgvector embedding
  relevanceScore Float?
  summary        String?  @db.Text
  category       String[]

  // Status tracking
  status ArticleStatus @default(PENDING_REVIEW)

  /**
   * When an editor said they did not want this at all. Null means they did not.
   * A column rather than a fourth ArticleStatus, for two reasons. Restoring returns the
   * article to the verdict it already had, which a status would have overwritten and lost.
   * And the two questions are genuinely independent: an approved article can be discarded,
   * and it is still an approved article when it comes back.
   * A soft discard rather than a DELETE, because deduplication is by
   * `@@unique([sourceUrl, organizationId])` and `lib/curation/deduplicator.ts` looks the row
   * up on that key. A deleted row stops matching, so the next collection run recreates the
   * article and the same unwanted story arrives every week for ever.
   */
  discardedAt DateTime?

  // Multi-tenant
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  editions EditionArticle[]

  /**
   * RQ-006 F6: hash of the text a rewrite was generated from, set on write. STALE was
   * a status nothing could ever assign, because nothing recorded what the article said
   * when the rewrite was made.
   */
  contentHash String?

  /**
   * True when this article's URL is the wrapper the newsletter used, not the article's
   * own address, because the redirect chain could not be followed.
   * Finding D4 of 6 August 2026: the wrapper was stored in silence and nothing recorded
   * it, so an edition could go out linking to link.mail.beehiiv.com with "Beehiiv" named
   * as the publisher, since the publication name is derived from the host. The flag is
   * what lets a screen say so and an editor decide.
   * Defaulting to false rather than backfilling: every row written before this existed
   * predates the distinction, and claiming to know which of them are wrapped would be
   * inventing data.
   */
  sourceUnresolved Boolean @default(false)

  /**
   * Where this article came from. Finding D1.
   * There was nothing here at all: the only trace of an article's origin was the string
   * in `sourceUrl`, so "what did this newsletter produce" was not answerable and "where
   * did this come from" could only be guessed from a hostname. The RSS collector already
   * carried a `sourceName` and the curator used it in log lines and then dropped it.
   * Both nullable, and for the same reason: the corpus predates them, an article can be
   * imported by hand or from a web search, and `SetNull` on delete means removing a source
   * does not remove the articles it found. A row with neither is honest about not knowing.
   */
  source   RSSSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceId String?

  /**
   * The email this came out of, when a newsletter is what produced it.
   */
  inboundEmail   InboundEmail? @relation(fields: [inboundEmailId], references: [id], onDelete: SetNull)
  inboundEmailId String?

  rewrites ArticleRewrite[]

  @@unique([sourceUrl, organizationId]) // Same article can exist in different orgs
  @@index([status])
  @@index([discardedAt])
  @@index([relevanceScore(sort: Desc)])
  @@index([publishedAt(sort: Desc)])
  @@index([organizationId])
  @@index([sourceId])
  @@index([inboundEmailId])
}

enum ArticleStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

// ==================== INTERNAL PROJECTS ====================

model Project {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  team        String
  projectDate DateTime
  impact      String?  @db.Text
  imageUrl    String?
  featured    Boolean  @default(false)

  // Multi-tenant
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  editions EditionProject[]

  @@index([featured])
  @@index([organizationId])
}

// ==================== NEWSLETTER EDITIONS ====================

model Edition {
  id String @id @default(cuid())

  /**
   * The day this edition is meant to go out, and the one date the product sorts by.
   * RQ-008: `week` and `year` used to be the identity, under a unique index, which made a
   * second edition inside one week impossible and left an edition with no way to carry a
   * name. They are still here, as a cache derived from this date by
   * `lib/editions/identity.ts` and written nowhere else, so every screen that reads
   * `edition.week` keeps working. `weeklySlot` carries the uniqueness the index had.
   */
  publishDate DateTime

  /**
   * The edition's own name. Null on a weekly, which is labelled from its date.
   */
  title String?

  kind EditionKind @default(WEEKLY)

  /**
   * "2026-W32" on a weekly edition, null on anything else.
   * This is what keeps the schedule from creating two proposals for one week. Postgres
   * treats nulls in a unique index as distinct, so a week holds exactly one weekly and
   * as many specials as anyone wants, without a partial index Prisma cannot express and
   * without an application-level lock.
   */
  weeklySlot String?

  /**
   * Derived from publishDate by lib/editions/identity.ts. Never set by a caller.
   */
  week Int
  /**
   * The ISO week-year, derived. Not always the calendar year of publishDate.
   */
  year Int

  status EditionStatus @default(DRAFT)

  scheduledDate DateTime?
  finalizedAt   DateTime?
  sentAt        DateTime?

  /**
   * What actually went out, frozen at the send. See lib/editions/sent-snapshot.ts.
   * Null on every edition sent before this existed, and on every edition not yet sent.
   * A reader must handle null by falling back to the live rows, which is what
   * `renderSourceFor` does.
   */
  sentSnapshot Json?

  /**
   * The closing "one more thing" block this edition will send.
   * SetNull and not Cascade: retiring a joke must never delete an edition. This is the
   * intention; `sentSnapshot` is the record of what actually went out.
   */
  aside   Aside?  @relation(fields: [asideId], references: [id], onDelete: SetNull)
  asideId String?

  // RQ-005 action 8, D5: archive is what happens to a sent edition. Absence of
  // the marker is the default, visible state, so nothing has to be backfilled.
  archivedAt DateTime?

  // RQ-005 BR-011: the approval that caused the send, recorded so a sent edition
  // can always answer who and when. Immutable once set.
  approvedAt      DateTime?
  approvedByEmail String?
  approvedById    String? // Supabase user id, survives the person leaving

  // RQ-005 action 1: the last time the schedule topped this proposal up. The
  // top-up only considers articles collected after it, so an article an editor
  // removed is never silently added back.
  proposalRefreshedAt DateTime?

  // Ghost Writer generated content
  generatedContent Json? // AI-generated newsletter content
  generatedAt      DateTime?

  // Unlayer editor state
  editorDesignJson Json? // Saved Unlayer design for this edition
  templateId       String? // Template used as base

  // SharePoint publishing
  sharePointUrl         String? // URL to published page
  sharePointPageId      String? // Graph API page ID
  sharePointPublishedAt DateTime? // When published
  sharePointError       String? // Last error message

  // Multi-tenant
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  articles EditionArticle[]
  projects EditionProject[]
  drafts   GenerationDraft[]

  // RQ-005 BR-013: the association that used to point at nothing. Delivery
  // history is now either preserved with the edition or removed with it.
  emailEvents EmailEvent[]

  // RQ-008: the weekly slot is the uniqueness now. Null on a special edition, and
  // Postgres treats nulls here as distinct, so a week binds one weekly and nothing else.
  @@unique([weeklySlot, organizationId])
  @@index([status])
  @@index([organizationId])
  @@index([archivedAt])
  @@index([publishDate(sort: Desc)])
  @@index([week, year])
}

enum EditionStatus {
  DRAFT
  FINALIZED
  SENT
}

enum EditionKind {
  /**
   * The edition the schedule creates once a week. Carries a weeklySlot.
   */
  WEEKLY
  /**
   * Anything else: a themed issue, a launch, a year in review. No slot.
   */
  SPECIAL
}

enum DraftStatus {
  DRAFT // Just generated
  APPROVED // Ready for send
  USED // Was sent
  DISCARDED // Rejected
}

// Join table: Edition <-> Articles (with ordering)
model EditionArticle {
  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  editionId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String
  order     Int

  @@id([editionId, articleId])
  @@index([editionId, order])
}

// Join table: Edition <-> Projects (with ordering)
model EditionProject {
  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  editionId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  order     Int

  @@id([editionId, projectId])
  @@index([editionId, order])
}

// Ghost Writer generation drafts for version history
model GenerationDraft {
  id String @id @default(cuid())

  content      Json // The full GeneratedNewsletter object
  brandVoiceId String? // Which voice was used

  status      DraftStatus @default(DRAFT)
  generatedAt DateTime    @default(now())
  approvedAt  DateTime?

  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  editionId String

  // Multi-tenant
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  @@index([editionId])
  @@index([organizationId])
  @@index([status])
}

// ==================== SUBSCRIBERS ====================

model Subscriber {
  id     String  @id @default(cuid())
  email  String
  name   String?
  active Boolean @default(true)

  // Preferences
  preferredLanguage String @default("en") // en, pt-pt, pt-br, es, ar
  preferredStyle    String @default("comprehensive") // executive, technical, comprehensive

  // Multi-tenant
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  events EmailEvent[]

  @@unique([email, organizationId]) // Same email can subscribe to different orgs
  @@index([active])
  @@index([email])
  @@index([preferredLanguage, active])
  @@index([preferredStyle, active])
  @@index([organizationId])
}

// ==================== EMAIL TRACKING ====================

model EmailEvent {
  id String @id @default(cuid())

  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  subscriberId String

  // RQ-005 BR-013: editionId was a bare String with no relation and no cascade,
  // so deleting an edition orphaned its delivery history instead of removing it.
  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  editionId String

  eventType EmailEventType
  timestamp DateTime       @default(now())

  // Optional metadata (click URL, bounce reason, etc.)
  metadata Json?

  @@index([subscriberId, eventType])
  @@index([editionId, eventType])
  @@index([timestamp])
  @@index([eventType, timestamp])
  @@index([editionId, eventType, timestamp])
}

enum EmailEventType {
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  UNSUBSCRIBED
}

// ==================== RSS SOURCES ====================

model RSSSource {
  id   String @id @default(cuid())
  name String

  /**
   * Where this source comes from.
   * For an EMAIL source this holds the sender address, which is naturally unique per
   * organization and keeps the existing unique index doing useful work. The alternative,
   * making the column optional, would weaken a constraint that earns its place for feeds.
   */
  url      String
  category String
  active   Boolean @default(true)

  // ---- RQ-007: email newsletters as a source ----
  type SourceType @default(RSS)

  /**
   * The newsletter's From address, the primary match key for an inbound email.
   */
  senderAddress       String?
  /**
   * The `+tag` used when subscribing, the fallback match key.
   */
  inboundTag          String?
  /**
   * One email to many articles, or one email to one article.
   */
  parseMode           ParseMode?
  /**
   * How often this source is expected to publish, for the silence warning.
   */
  expectedCadenceDays Int?
  /**
   * Last time an email from this source arrived, which is the health signal.
   */
  lastReceivedAt      DateTime?

  lastFetchedAt DateTime?
  lastError     String?

  // Multi-tenant
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * Finding D1: the articles this source produced, so the question is answerable.
   */
  articles Article[]

  @@unique([url, organizationId]) // Same RSS can be used by different orgs
  @@index([active])
  @@index([organizationId])
  @@index([type, active])
  @@index([senderAddress])
}

enum SourceType {
  RSS
  EMAIL
}

enum ParseMode {
  /**
   * One email carrying many linked articles.
   */
  DIGEST
  /**
   * One email that is itself the article.
   */
  ESSAY
}

// ==================== PLATFORM SETTINGS ====================

// Global platform settings (for platform-wide defaults)
model Settings {
  id                        String   @id @default("default")
  relevanceThreshold        Float    @default(6.0)
  maxArticlesPerEdition     Int      @default(10)
  vectorSimilarityThreshold Float    @default(0.85)
  articleMaxAgeDays         Int      @default(7)
  aiModel                   String   @default("claude-sonnet-5")
  embeddingModel            String   @default("text-embedding-ada-002")
  brandVoicePrompt          String?  @db.Text
  updatedAt                 DateTime @updatedAt
}

// Note: Per-organization settings are in OrgSettings model above

// ==================== CURATION JOBS ====================

model CurationJob {
  id          String            @id @default(cuid())
  status      CurationJobStatus @default(RUNNING)
  totalFound  Int               @default(0)
  processed   Int               @default(0)
  duplicates  Int               @default(0)
  lowScore    Int               @default(0)
  curated     Int               @default(0)
  errorsCount Int               @default(0)
  startedAt   DateTime          @default(now())
  completedAt DateTime?
  durationMs  Int?
  logs        Json              @default("[]")

  // Multi-tenant
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  @@index([status])
  @@index([startedAt(sort: Desc)])
  @@index([organizationId])
}

enum CurationJobStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// ==================== EMAIL TEMPLATES ====================

model EmailTemplate {
  id          String  @id @default(cuid())
  name        String
  description String?
  designJson  Json?
  html        String  @db.Text
  isActive    Boolean @default(false)
  isDefault   Boolean @default(false)

  // Multi-tenant
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([isDefault])
  @@index([organizationId])
}

// ==================== MEDIA ASSETS ====================

model MediaAsset {
  id       String @id @default(cuid())
  filename String
  url      String
  type     String // e.g., "image/png", "image/jpeg"
  size     Int // file size in bytes

  // Multi-tenant
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt(sort: Desc)])
  @@index([organizationId])
}

// Note: BrandingSettings has been merged into OrgSettings for multi-tenant support

// ==================== TREND RADAR (WEB SEARCH) ====================

// Saved search topics/watchlists for ongoing monitoring
model SearchTopic {
  id          String  @id @default(cuid())
  name        String // Human-readable name: "DORA Regulation News"
  description String? @db.Text

  // Search configuration
  query         String   @db.Text // Natural language query
  queryExpanded String?  @db.Text // AI-expanded query for better results
  providers     String[] @default(["tavily"]) // Which search providers to use

  // Scheduling
  schedule  SearchSchedule @default(MANUAL)
  lastRunAt DateTime?
  nextRunAt DateTime?

  // Filters
  timeRange  SearchTimeRange @default(WEEK)
  maxResults Int             @default(20)

  // Status
  isActive Boolean @default(true)

  // Multi-tenant
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  results              SearchResult[]
  convertedFromHistory SearchHistory[]

  @@index([organizationId])
  @@index([isActive])
  @@index([nextRunAt])
  @@index([schedule, isActive])
}

enum SearchSchedule {
  MANUAL // Only run on demand
  DAILY // Run once per day
  WEEKLY // Run once per week
}

enum SearchTimeRange {
  DAY // Last 24 hours
  WEEK // Last 7 days
  MONTH // Last 30 days
  YEAR // Last 365 days
}

// Individual search results from web searches
model SearchResult {
  id String @id @default(cuid())

  // Source information
  url         String
  title       String
  snippet     String    @db.Text
  content     String?   @db.Text // Full content if available
  publishedAt DateTime?
  source      String? // Domain or publication name
  author      String?
  imageUrl    String?

  // Search metadata
  provider String // Which provider found this: tavily, brave, etc.
  rawScore Float? // Provider's relevance score

  // AI analysis
  aiScore         Float? // Claude relevance score (1-10)
  aiSummary       String?  @db.Text
  aiTopics        String[] // Extracted topics
  aiSentiment     String? // positive, negative, neutral
  aiRelevanceNote String?  @db.Text // Why it's relevant

  // Status
  status            SearchResultStatus @default(NEW)
  importedArticleId String? // If imported to articles

  // Parent topic
  searchTopic   SearchTopic @relation(fields: [searchTopicId], references: [id], onDelete: Cascade)
  searchTopicId String

  createdAt DateTime @default(now())

  @@unique([url, searchTopicId]) // No duplicate URLs per topic
  @@index([searchTopicId])
  @@index([status])
  @@index([aiScore(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

enum SearchResultStatus {
  NEW // Just discovered
  REVIEWED // Human has seen it
  IMPORTED // Imported to articles
  DISMISSED // Marked as not relevant
}

// ==================== SEARCH HISTORY ====================

// Tracks ad-hoc searches for recall and potential conversion to topics
model SearchHistory {
  id            String  @id @default(cuid())
  query         String  @db.Text
  queryExpanded String? @db.Text
  queryAnalysis Json? // { intent, timeScope, topics }

  resultCount Int
  results     Json // Snapshot of AnalyzedResult[]

  searchedAt DateTime @default(now())

  // If converted to a topic
  convertedToTopicId String?
  convertedTopic     SearchTopic? @relation(fields: [convertedToTopicId], references: [id])

  // Multi-tenant
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  @@index([organizationId])
  @@index([searchedAt(sort: Desc)])
}

// ==================== BACKGROUND JOBS ====================

model BackgroundJob {
  id           String    @id @default(cuid())
  type         JobType
  status       JobStatus @default(RUNNING)
  progress     Int       @default(0)
  currentStage String?
  metadata     Json      @default("{}")
  result       Json?
  error        String?
  logs         Json      @default("[]")
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  // Multi-tenant
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  @@index([type, status])
  @@index([organizationId])
  @@index([startedAt(sort: Desc)])
}

enum JobType {
  GENERATION
  SEARCH
  EMAIL_SEND
  EMAIL_INGESTION
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// ==================== Trend Radar (RQ-004, phase A) ====================

/**
 * An entity the radar watches: a protocol, a model, a company, a technique.
 * Global rather than per-organization, deliberately. How often "Model Context
 * Protocol" is mentioned on Hacker News is a fact about the world, not about a
 * tenant, so it is counted once and read by everyone. Which entities an
 * organization cares about is the tenant's business, and that lives in RadarWatch.
 * This also dissolves the flaw in the original plan's schema, where signal points
 * carried a nullable organizationId inside a unique key. Postgres treats NULLs as
 * distinct, so that key permitted exactly the duplicates it was written to prevent.
 * Here nothing in the key is nullable.
 */
model RadarEntity {
  id   String     @id @default(cuid())
  /**
   * Stable, lowercase, hyphenated. The identity used in seeds and reports.
   */
  slug String     @unique
  name String
  kind EntityKind

  /**
   * Per-source queries, validated rather than derived from the name.
   * A name reused as a query is the failure the plan review calls make-or-break:
   * "MCP" on Hacker News returns Minecraft Coder Pack and Microsoft Certified
   * Professional, "Claude" is a given name, "Grok" is a verb. A wrong count does
   * not announce itself, it becomes an acceleration.
   * Null means this entity is not collected from that source.
   */
  hnQuery    String?
  arxivQuery String?

  /**
   * Measured precision of each query, from a sampled review, and when it was
   * measured. An entity below the threshold is deactivated rather than counted.
   */
  hnPrecision       Float?
  arxivPrecision    Float?
  precisionMeasured DateTime?
  precisionNotes    String?

  /**
   * Off means collect nothing. Set when validation fails, or by hand.
   */
  active Boolean @default(true)

  signals SignalPoint[]
  watches RadarWatch[]
  gaps    SignalGap[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([kind])
}

enum EntityKind {
  PROTOCOL
  MODEL
  COMPANY
  TECHNIQUE
  PRODUCT
  BENCHMARK
}

/**
 * Which organizations watch which entities.
 */
model RadarWatch {
  id String @id @default(cuid())

  entity   RadarEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  entityId String

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  createdAt DateTime @default(now())

  @@unique([entityId, organizationId])
  @@index([organizationId])
}

/**
 * One count, for one entity, from one source, on one day.
 * `date` is midnight UTC of the day counted, so a re-run of the same day updates
 * the row rather than adding a second one. That is what makes collection idempotent
 * and it is why the unique key has no nullable column in it.
 * Collection is forward-only: there is no backfill, so a gap in the series is a day
 * the collector did not run, and `SignalGap` records why rather than leaving a
 * missing row to be read as a zero.
 */
model SignalPoint {
  id String @id @default(cuid())

  entity   RadarEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  entityId String

  source SignalSource
  /**
   * Midnight UTC of the day this count covers.
   */
  date   DateTime
  count  Int

  /**
   * What was actually asked, kept so a series can be audited after a query change.
   */
  query String

  collectedAt DateTime @default(now())

  @@unique([entityId, source, date])
  @@index([source, date])
  @@index([entityId, source, date])
}

enum SignalSource {
  HN
  ARXIV
}

/**
 * A day the collector could not count.
 * Without this, a failed fetch is indistinguishable from a genuine zero, and a
 * baseline built over a week of outages reads as a week of silence. The scorer in
 * phase B has to be able to tell the difference.
 */
model SignalGap {
  id String @id @default(cuid())

  entity   RadarEntity? @relation(fields: [entityId], references: [id], onDelete: Cascade)
  entityId String?

  source SignalSource
  date   DateTime
  reason String

  createdAt DateTime @default(now())

  @@index([source, date])
}

// ==================== Link Take (RQ-006) ====================

/**
 * An original short editorial piece written from a curated article.
 * Deliberately not `articleId @unique`. The plan had one rewrite per article, which
 * means regeneration overwrites history, and for a feature whose main risk is
 * copyright and fabrication the thing most wanted six months later is exactly what
 * that destroys: what was published, generated from what input, by which model, and
 * whether the checks passed. Old rows stay and carry `supersededAt` (review F5).
 * The check record is not decoration. With no guarantee that a human reads a piece
 * before it reaches a subscriber, these checks are the only control, so every row
 * carries its result and a complaint can be answered with evidence rather than
 * intent.
 */
model ArticleRewrite {
  id String @id @default(cuid())

  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String

  title String
  body  String @db.Text

  language  String       @default("pt-PT")
  model     String
  inputMode RewriteInput

  status RewriteStatus @default(GENERATED)
  error  String?

  /**
   * RQ-006 F2: the mechanical checks, and their evidence.
   */
  checksPassed     Boolean
  checkSummary     String? @db.Text
  /**
   * The failure list, as returned by lib/rewrite/checks.ts.
   */
  checkFailures    Json?
  /**
   * Longest run of words shared with the source. Kept when it passes too: a low
   * number is the evidence that the piece is not a reproduction.
   */
  longestSharedRun Int?
  wordCount        Int?

  /**
   * What the article said when this was written, for STALE (F6).
   */
  sourceHash String?

  /**
   * The editor's ask for this version, typed next to Regenerate. Null on every automatic
   * generation.
   *
   * On the row rather than on OrgSettings: the standing instructions are
   * `OrgSettings.brandVoicePrompt` and `orgContextPrompt`, and a one-off ask stored there
   * would reshape every article generated afterwards. Here it is also what lets the
   * history answer why one version reads differently from the one it superseded.
   */
  instruction String? @db.Text

  /**
   * Set when a newer rewrite replaces this one. Nothing is deleted.
   */
  supersededAt DateTime?

  generatedAt DateTime @default(now())

  @@index([articleId, supersededAt])
  @@index([status])
  @@index([generatedAt(sort: Desc)])
}

enum RewriteInput {
  FULL_TEXT
  EXCERPT
}

enum RewriteStatus {
  GENERATED
  /**
   * The checks refused it, or generation failed. Never shown to a reader.
   */
  FAILED
  /**
   * The article changed after this was written; regenerate on next open.
   */
  STALE
}

// ==================== Inbound email (RQ-007) ====================

/**
 * One email that arrived at the ingestion address.
 * Deliberately not organization-scoped. An email arriving at a shared address does not
 * belong to a tenant until a source claims it, and pretending otherwise would mean
 * guessing. The consequence is stated rather than hidden: the unknown-senders view over
 * these rows is platform-wide, so it is restricted to an OWNER.
 * Rows are kept after processing, and after being ignored. Keeping the ignored ones is
 * what makes "promote this sender to a source and process what it already sent" possible.
 */
model InboundEmail {
  id String @id @default(cuid())

  /**
   * The webhook's own id for this email, and the idempotency key. A replayed delivery
   * and a transport retry must not produce a second row.
   */
  resendEmailId String @unique

  /**
   * The original sender, preserved through the forwarding rule.
   */
  from          String
  /**
   * The address it arrived at, such as radar+tldr@example.com.
   */
  to            String
  /**
   * The `+tag` from `to`, lowercased. Null when the address carried none.
   */
  subaddressTag String?

  subject    String?
  receivedAt DateTime @default(now())

  /**
   * Sanitized. Fetched by the job rather than by the webhook, so both are null until then.
   */
  html String?
  text String?

  /**
   * Starts at CONTENT_PENDING, because the webhook stores metadata and returns.
   * The `email.received` payload carries no body, so content needs a second call to the
   * Receiving API. Making that call inside the webhook would add a network dependency to
   * the one part of this system that must answer fast, and the retry loop that recovers a
   * failed fetch has to exist either way.
   */
  status      InboundEmailStatus @default(CONTENT_PENDING)
  error       String?
  /**
   * Content fetch attempts. Three, then FAILED.
   */
  retryCount  Int                @default(0)
  processedAt DateTime?

  /**
   * When a run took this row to work on, so two runs cannot process it at once.
   * A lease rather than a status, for two reasons. A `PROCESSING` state would strand rows
   * for ever when a run is killed mid flight, which is exactly what the 300-second ceiling
   * does; a timestamp expires by itself. And `processedAt` already means something else:
   * conflating two meanings in one column is the defect this requirement spent 6 August
   * 2026 removing from the extractor.
   */
  claimedAt DateTime?

  /**
   * Finding D1: what this email produced, which is the whole point of keeping it.
   */
  articles Article[]

  @@index([status, receivedAt])
  @@index([status, claimedAt])
  @@index([from])
  @@index([subaddressTag])
}

enum InboundEmailStatus {
  /**
   * Metadata stored, content not fetched yet, or the fetch failed and will be retried.
   */
  CONTENT_PENDING
  /**
   * Content in hand, awaiting extraction.
   */
  RECEIVED
  PROCESSED
  /**
   * No active EMAIL source matches the sender or the tag. Kept, so it can be promoted.
   */
  IGNORED_UNKNOWN_SENDER
  FAILED
}

enum AsideKind {
  JOKE
  NOTE
  SPOTLIGHT
}

enum AsideStatus {
  PENDING
  APPROVED
  RETIRED
}

enum AsideSource {
  HUMAN
  MODEL
}

/**
 * The closing slot's library.
 * Everything that appears in an edition's "one more thing" block is a row here, including
 * free text typed on the send screen at the last minute. One code path, and "what did
 * edition 32 send" has one answer.
 */
model Aside {
  id String @id @default(cuid())

  kind   AsideKind   @default(JOKE)
  status AsideStatus @default(APPROVED)

  /**
   * Kept after approval: whether a forwarded joke came from a person is worth knowing later.
   */
  source AsideSource @default(HUMAN)

  /**
   * The payload. Required even with an image, because it is also the image's alt text.
   */
  text String

  /**
   * A public URL from the newsletter-media bucket.
   */
  imageUrl String?

  attribution String?

  /**
   * Filtered against OrgSettings.rewriteLanguage. A machine-translated joke is not a joke,
   * so a second language is a second hand-written row, never a translation of this one.
   */
  language String @default("pt-PT")

  /**
   * False on free text typed at send time, so a one-off note never returns in the picker.
   */
  reusable Boolean @default(true)

  /**
   * Written when an edition is sent, never when one is chosen or previewed.
   */
  lastUsedAt DateTime?
  useCount   Int       @default(0)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  editions Edition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status, kind, language, lastUsedAt])
  @@index([organizationId, status, createdAt(sort: Desc)])
}
